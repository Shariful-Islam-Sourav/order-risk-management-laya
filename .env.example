# Order Risk Detector - Environment Variables
# Copy this file to .env and fill in your values

# ─── Laya / Laya Studio ────────────────────────────────────────────────────────
# Option A: Use the hosted Laya Studio API (https://laya.studio)
#   Sign up at https://laya.studio/signup to get an API key.
#   5 free runs, then $0.0294 per 1M input tokens.
LAYA_BASE_URL=https://api.laya.studio
LAYA_API_KEY=your_laya_studio_api_key_here

# Option B: Self-host laya-serve locally
#   1. Install: pip install "laya[serve]"
#   2. Run:     LAYA_PRELOAD=1 laya-serve   (binds to 0.0.0.0:8000)
#   Then change LAYA_BASE_URL to:
# LAYA_BASE_URL=http://localhost:8000
# LAYA_API_KEY=   (leave empty for local, or set LAYA_API_KEY env var on the server)

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3000
